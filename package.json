{
  "name": "wallet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "lefthook install",
    "build": "rsbuild build",
    "check": "biome check --write",
    "lint": "biome check",
    "clean": "rm -rf node_modules && rm -rf dist",
    "dev": "rsbuild dev --open",
    "deploy": "bun run build && wrangler pages deploy",
    "preview": "rsbuild preview",
    "typecheck": "tsgo --noEmit",
    "test:unit": "bun test src/domain src/lib src/infra src/hooks src/contexts",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "test": "bun run test:unit && bun run test:components"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@bloque/sdk": "^0.7.0",
    "@bloque/sdk-accounts": "^0.7.0",
    "@bloque/sdk-identity": "^0.7.0",
    "@bloque/sdk-swap": "^0.7.0",
    "@fontsource-variable/outfit": "^5.2.8",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.159.4",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.0.8",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.3.6",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.11",
    "shadcn": "^3.8.4",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "^1.62.0",
    "@rsbuild/core": "^2.1.0",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.105.0"
  },
  "overrides": {
    "@bloque/sdk-accounts": "0.7.0",
    "@bloque/sdk-compliance": "0.7.0",
    "@bloque/sdk-core": "0.7.0",
    "@bloque/sdk-identity": "0.7.0",
    "@bloque/sdk-orgs": "0.7.0",
    "@bloque/sdk-swap": "0.7.0"
  }
